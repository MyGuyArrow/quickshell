import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Services.Mpris
import Quickshell.Services.Pipewire

PanelWindow {
    id: root

    property bool manuallyExpanded: false
    property bool volumePopup: false
    property date now: new Date()

    property var player: Mpris.players.values.length > 0
        ? Mpris.players.values[0]
        : null

    property var sink: Pipewire.defaultAudioSink

    property bool mediaActive: player !== null
        && player.playbackState !== MprisPlaybackState.Stopped

    property bool expanded:
        volumePopup
        || manuallyExpanded
        || mediaActive

    anchors {
        top: true
        left: true
        right: true
    }

    implicitHeight: 104
    color: "transparent"
    exclusiveZone: 0
    aboveWindows: true
    focusable: false

    PwObjectTracker {
        objects: [root.sink]
    }

    IpcHandler {
        target: "island"

        function volume(): void {
            root.volumePopup = true
            volumeTimer.restart()
        }
    }

    mask: Region {
        item: island
    }

    Rectangle {
        id: island

        anchors {
            top: parent.top
            topMargin: 10
            horizontalCenter: parent.horizontalCenter
        }

        width: root.volumePopup
            ? 330
            : root.expanded
                ? 460
                : 180

        height: root.volumePopup
            ? 58
            : root.expanded
                ? 76
                : 40

        radius: height / 2
        color: "#050505"

        Behavior on width {
            NumberAnimation {
                duration: 220
                easing.type: Easing.OutCubic
            }
        }

        Behavior on height {
            NumberAnimation {
                duration: 220
                easing.type: Easing.OutCubic
            }
        }

        // IDLE
        RowLayout {
            anchors {
                fill: parent
                leftMargin: 15
                rightMargin: 15
            }

            visible: !root.expanded
            spacing: 10

            Rectangle {
                width: 9
                height: 9
                radius: 5
                color: "#39d353"
            }

            Text {
                text: Qt.formatTime(root.now, "hh:mm")
                color: "white"
                font.pixelSize: 14
                font.weight: Font.DemiBold
            }

            Item {
                Layout.fillWidth: true
            }

            Text {
                text: {
                    if (!root.sink || !root.sink.audio)
                        return ""

                    if (root.sink.audio.muted)
                        return "Muted"

                    return Math.round(root.sink.audio.volume * 100) + "%"
                }

                color: "#a1a1aa"
                font.pixelSize: 12
            }
        }

        // VOLUME POPUP
        RowLayout {
            anchors {
                fill: parent
                leftMargin: 18
                rightMargin: 18
            }

            visible: root.volumePopup
            spacing: 14

            Text {
                text: {
                    if (!root.sink || !root.sink.audio)
                        return "🔊"

                    return root.sink.audio.muted ? "🔇" : "🔊"
                }

                color: "white"
                font.pixelSize: 20
            }

            Rectangle {
                Layout.fillWidth: true
                height: 7
                radius: 4
                color: "#27272a"

                Rectangle {
                    height: parent.height
                    radius: parent.radius

                    width: {
                        if (!root.sink || !root.sink.audio)
                            return 0

                        return parent.width
                            * Math.min(root.sink.audio.volume, 1.0)
                    }

                    color: "white"

                    Behavior on width {
                        NumberAnimation {
                            duration: 120
                            easing.type: Easing.OutCubic
                        }
                    }
                }
            }

            Text {
                text: {
                    if (!root.sink || !root.sink.audio)
                        return "--"

                    return Math.round(root.sink.audio.volume * 100) + "%"
                }

                color: "white"
                font.pixelSize: 13
                font.weight: Font.DemiBold
            }
        }

        // MEDIA
        RowLayout {
            anchors {
                fill: parent
                leftMargin: 14
                rightMargin: 18
            }

            visible: root.expanded && !root.volumePopup
            spacing: 14

            Rectangle {
                width: 50
                height: 50
                radius: 12
                color: "#18181b"

                Image {
                    anchors.fill: parent
                    anchors.margins: 2

                    visible: root.player !== null
                        && root.player.trackArtUrl !== ""

                    source: root.player
                        ? root.player.trackArtUrl
                        : ""

                    fillMode: Image.PreserveAspectCrop
                }

                Text {
                    anchors.centerIn: parent

                    visible: root.player === null
                        || root.player.trackArtUrl === ""

                    text: "♪"
                    color: "white"
                    font.pixelSize: 24
                }
            }

            ColumnLayout {
                Layout.fillWidth: true
                spacing: 1

                Text {
                    Layout.fillWidth: true

                    text: root.player
                        ? (root.player.trackTitle || "Unknown Track")
                        : "Arch VM"

                    color: "white"
                    font.pixelSize: 14
                    font.weight: Font.DemiBold

                    elide: Text.ElideRight
                    maximumLineCount: 1
                }

                Text {
                    Layout.fillWidth: true

                    text: root.player
                        ? (root.player.trackArtist || "Unknown Artist")
                        : "Hyprland"

                    color: "#a1a1aa"
                    font.pixelSize: 12

                    elide: Text.ElideRight
                    maximumLineCount: 1
                }
            }

            RowLayout {
                spacing: 12

                Text {
                    text: "‹"
                    color: root.player && root.player.canGoPrevious
                        ? "white"
                        : "#52525b"

                    font.pixelSize: 26

                    MouseArea {
                        anchors.fill: parent

                        onClicked: {
                            if (root.player && root.player.canGoPrevious)
                                root.player.previous()
                        }
                    }
                }

                Text {
                    text: root.player && root.player.isPlaying
                        ? "Ⅱ"
                        : "▶"

                    color: "white"
                    font.pixelSize: 18

                    MouseArea {
                        anchors.fill: parent

                        onClicked: {
                            if (root.player && root.player.canTogglePlaying)
                                root.player.isPlaying = !root.player.isPlaying
                        }
                    }
                }

                Text {
                    text: "›"
                    color: root.player && root.player.canGoNext
                        ? "white"
                        : "#52525b"

                    font.pixelSize: 26

                    MouseArea {
                        anchors.fill: parent

                        onClicked: {
                            if (root.player && root.player.canGoNext)
                                root.player.next()
                        }
                    }
                }
            }
        }

        MouseArea {
            anchors.fill: parent
            propagateComposedEvents: true

            onClicked: function(mouse) {
                if (!root.volumePopup)
                    root.manuallyExpanded = !root.manuallyExpanded

                mouse.accepted = false
            }
        }
    }

    Timer {
        id: volumeTimer

        interval: 1400
        repeat: false

        onTriggered: root.volumePopup = false
    }

    Timer {
        interval: 1000
        running: true
        repeat: true

        onTriggered: root.now = new Date()
    }
}
